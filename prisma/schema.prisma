// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// A merchant-built form. Every query is scoped by `shop` (multi-tenant).
model Form {
  id           String    @id @default(cuid())
  shop         String
  // Short public token used on the storefront (app block setting, data-tcl-form attribute).
  publicId     String    @unique
  name         String
  // DRAFT | PUBLISHED
  status       String    @default("DRAFT")
  templateKey  String?
  // { version, fields[], settings{} }
  schema       Json
  // Design tokens for wide viewports.
  desktopStyle Json
  // Sparse overrides for small viewports; unset keys fall back to desktopStyle.
  mobileStyle  Json
  // { mode, openMode, triggers[], targets[], buttonBindings[] }
  placement    Json
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  submissions Submission[]

  @@index([shop, status])
  @@index([shop, updatedAt])
}

// A single form submission captured through the App Proxy endpoint.
model Submission {
  id     String @id @default(cuid())
  shop   String
  formId String
  form   Form   @relation(fields: [formId], references: [id], onDelete: Cascade)
  // Sanitized { fieldId: value } — never raw input.
  data   Json
  // { pageUrl, referer, userAgent, customerId, durationMs, source }
  meta   Json
  isRead Boolean @default(false)
  // Truncated sha256(ip + secret). Used for rate limiting only, never for analytics.
  ipHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop, formId, createdAt])
  @@index([shop, isRead, createdAt])
}

// DB-backed rate limiting, so limits hold across multiple Render instances.
model RateLimit {
  id     String @id @default(cuid())
  key    String
  // Unix-minute bucket, used as the sliding window key.
  bucket Int
  count  Int    @default(0)

  @@unique([key, bucket])
  @@index([bucket])
}

// A blog post built in the drag-and-drop blog editor. `doc` holds the block
// tree and page design; publishing renders it to HTML and writes it to the
// linked Shopify article.
model BlogPost {
  id            String    @id @default(cuid())
  shop          String
  title         String
  doc           Json
  // DRAFT | PUBLISHED
  status        String    @default("DRAFT")
  blogId        String?
  articleId     String?
  blogHandle    String?
  articleHandle String?
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([shop, updatedAt])
}

// Recent events shown on the Home page ("Imported 12 pages", "Published a blog
// post"…). Repeated events of the same kind merge into one row.
model ActivityLog {
  id        String   @id @default(cuid())
  shop      String
  // pages_imported | bulk_saved | blog_published | form_created | form_published | submissions_received
  kind      String
  label     String   @default("")
  count     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop, updatedAt])
}
